# Copy to `.env` in this folder (rename: copy this file's contents into .env).
# Committed template — safe to share. Your real `.env` stays gitignored.

# --- Zoom webhook bridge ---
# Zoom Marketplace app → Feature → Event subscriptions → Secret Token
ZOOM_WEBHOOK_SECRET_TOKEN=paste_zoom_secret_token_here

# Secret Token of the 100BM Zoom account's app (its webhooks post to /100bm).
# Leave unset to keep the /100bm endpoint disabled.
# ZOOM_WEBHOOK_SECRET_TOKEN_100BM=

# Separate Zoho Flow webhook URL for 100BM events (optional).
# Unset → 100BM events go to ZOHO_WEBHOOK_FORWARD_URL like everything else.
# ZOHO_WEBHOOK_FORWARD_URL_100BM=

# LEP (IL LEP Sessions) — webhooks post to /lep (account 1), /lep2, /lep3, /lep4
# Each Zoom Marketplace app has its own Secret Token → use a matching path.
# ZOOM_WEBHOOK_SECRET_TOKEN_LEP=     # account 1 → https://YOUR-RENDER.onrender.com/lep
# ZOOM_WEBHOOK_SECRET_TOKEN_LEP_2=   # account 2 → .../lep2
# ZOOM_WEBHOOK_SECRET_TOKEN_LEP_3=   # account 3 → .../lep3
# ZOOM_WEBHOOK_SECRET_TOKEN_LEP_4=   # account 4 → .../lep4
# ZOHO_WEBHOOK_FORWARD_URL_LEP=      # one Zoho Flow for all LEP accounts
# Optional comma-separated topic substrings (default: il lep sessions,il lep,lep day,2 day session)
# LEP_TOPIC_KEYWORDS=il lep sessions,il lep,ironlady lep,lep day,2 day session

# Persist roster for MC/100BM optional cache. LEP durable mode uses Upstash Redis
# (do NOT rely on /tmp for LEP Check1/2/3 history).
# BRIDGE_STATE_PATH=/tmp/bridge_meetings.json
# BRIDGE_STATE_PERSIST=0

# --- Durable LEP (Upstash Redis + QStash) ---
# Connectivity test runs when Redis URL/TOKEN are set (startup log: [lep/redis-test] working).
# Attendance durable mode stays OFF until LEP_DURABLE=1 (legacy /lep timers unchanged).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# LEP_DURABLE=0
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
# Optional: LEP_REDIS_TTL_SECONDS=604800
# Local/manual internal tests only: QSTASH_SKIP_VERIFY=1

# Zoho Flow → Webhook trigger → full incoming URL (includes ?zapikey=...)
ZOHO_WEBHOOK_FORWARD_URL=paste_zoho_flow_webhook_url_here

# MC checkpoint delays from planned start (Meeting Link Manager) or Zoom meeting.started
# MC_CHECKPOINT_1_SECONDS=900
# MC_CHECKPOINT_2_SECONDS=1800
# MC_CHECKPOINT_3_SECONDS=3600
# MC_USE_MLM_PLANNED_START=1   — schedule T+15/T+30/T+60 from CRM planned time (recommended)

# Zoho CRM OAuth for Meeting Link Manager planned start lookup (MC checkpoints)
# ZOHO_CRM_CLIENT_ID=
# ZOHO_CRM_CLIENT_SECRET=
# ZOHO_CRM_REFRESH_TOKEN=
# ZOHO_CRM_ACCOUNTS_URL=https://accounts.zoho.in
# ZOHO_CRM_API_URL=https://www.zohoapis.in/crm/v7

# 100BM checkpoint delays (seconds from Zoom meeting.started). Defaults: 900 / 1800 / 3600
# BM100_CHECKPOINT_1_SECONDS=900
# BM100_CHECKPOINT_2_SECONDS=1800
# BM100_CHECKPOINT_3_SECONDS=3600

# --- Optional: Zoom Server-to-Server OAuth (if you use env instead of zoom_config.json) ---
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# --- Railway (set in dashboard Variables, not only .env) ---
# ZOOM_WEBHOOK_SECRET_TOKEN=
# ZOHO_WEBHOOK_FORWARD_URL=
# PORT is set automatically by Railway; do not override unless you know why.
