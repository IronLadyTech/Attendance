// Zoho Flow custom function — Fresh LEP FT checkpoint (T+15 / T+30 / T+60 present in meeting)
// Signature: void mark_fresh_lep_ft_attendance_yes(string meeting_id, string participant_email, string participant_name, string meeting_topic, string session_date)
// Connection: zoho_flow_to_zoho_crm (+ zoho_sheet_mc for unmatched)
//
// Eligibility: Fresh_LEP_FT_Confirmation must be "Yes". Confirmation is NEVER changed.
// On Yes: Fresh_LEP_FT_Attendance = Yes.
// Verify API names in CRM Setup → Leads → Fields if updates fail.
//
// Called by: Zoho Flow "Fresh_LEP_FT_Attendance" decision branch
//   Payload > Event equals attendance.mark_yes
//   (same pattern as tools/zoho_flow/100BM_CHECKPOINT_FLOW_WIRING.md → mark_100bm_attendance_yes)
// Not invoked from Python in this repo — paste into Zoho Flow custom functions.
//
// Flow mapping:
//   meeting_id        = ${webhookTrigger.payload.meeting_id}
//   participant_email = ${webhookTrigger.payload.participant_email}
//   participant_name  = ${webhookTrigger.payload.participant_name}
//   meeting_topic     = ${webhookTrigger.payload.meeting_topic}
//   session_date      = ${webhookTrigger.payload.session_date}

void mark_fresh_lep_ft_attendance_yes(string meeting_id, string participant_email, string participant_name, string meeting_topic, string session_date)
{
info "FLEP-FT YES: email=" + participant_email + " name=" + participant_name + " topic=" + meeting_topic + " session=" + session_date;
if(meeting_topic == null || meeting_topic.trim() == "" || meeting_topic == "null")
{
	info "FLEP-FT YES: no meeting topic - skipping";
	return;
}
topicL = meeting_topic.toLowerCase();
// Topic: "Fast Track Session - Iron Lady" (Thursday 8:00 PM IST)
if(!topicL.contains("fast track session"))
{
	info "FLEP-FT YES: unknown topic - skipping: " + meeting_topic;
	return;
}
if(session_date == null || session_date.trim() == "" || session_date == "null")
{
	info "FLEP-FT YES: session_date missing - skipping";
	return;
}
lead_list = List();
// --- Find lead by email ---
if(participant_email != null && participant_email.trim() != "" && participant_email != "null")
{
	ls = zoho.crm.searchRecords("Leads","(Email:equals:" + participant_email + ")",1,5);
	if(ls != null && ls.size() > 0)
	{
		lead_list.add(ls.get(0));
	}
}
// --- Name fallback ---
if(lead_list == null || lead_list.size() == 0)
{
	if(participant_name != null && participant_name.trim() != "" && participant_name != "null")
	{
		clean_name = participant_name.replaceAll("Ms. ","").replaceAll("Mr. ","").replaceAll("Mrs. ","").replaceAll("Dr. ","").replaceAll("Prof. ","").replaceAll("Miss ","").replaceAll("Rev. ","").trim();
		if(clean_name.length() > 0)
		{
			space_idx = clean_name.indexOf(" ");
			if(space_idx > 0)
			{
				raw_first = clean_name.substring(0,space_idx).trim();
				last_space_idx = clean_name.lastIndexOf(" ");
				raw_last = clean_name.substring(last_space_idx + 1).trim();
				if(raw_first.length() > 1 && raw_last.length() > 1)
				{
					first_tc = raw_first.substring(0,1).toUpperCase() + raw_first.substring(1).toLowerCase();
					last_tc = raw_last.substring(0,1).toUpperCase() + raw_last.substring(1).toLowerCase();
					lead_list = zoho.crm.searchRecords("Leads","(First_Name:equals:" + first_tc + ")and(Last_Name:equals:" + last_tc + ")",1,5);
					if(lead_list == null || lead_list.size() == 0)
					{
						lead_list = zoho.crm.searchRecords("Leads","(First_Name:equals:" + raw_first.toUpperCase() + ")and(Last_Name:equals:" + raw_last.toUpperCase() + ")",1,5);
					}
					if(lead_list == null || lead_list.size() == 0)
					{
						lead_list = zoho.crm.searchRecords("Leads","(First_Name:equals:" + raw_first.toLowerCase() + ")and(Last_Name:equals:" + raw_last.toLowerCase() + ")",1,5);
					}
				}
				if(lead_list == null || lead_list.size() == 0)
				{
					lead_list = zoho.crm.searchRecords("Leads","(Last_Name:equals:" + clean_name + ")",1,5);
				}
				if(lead_list == null || lead_list.size() == 0)
				{
					lead_list = zoho.crm.searchRecords("Leads","(Last_Name:equals:" + clean_name.toUpperCase() + ")",1,5);
				}
				if(lead_list == null || lead_list.size() == 0)
				{
					lead_list = zoho.crm.searchRecords("Leads","(Last_Name:equals:" + clean_name.toLowerCase() + ")",1,5);
				}
			}
			else
			{
				name_tc = clean_name.substring(0,1).toUpperCase() + clean_name.substring(1).toLowerCase();
				lead_list = zoho.crm.searchRecords("Leads","(Last_Name:equals:" + name_tc + ")",1,5);
				if(lead_list == null || lead_list.size() == 0)
				{
					lead_list = zoho.crm.searchRecords("Leads","(First_Name:equals:" + name_tc + ")",1,5);
				}
			}
		}
	}
}
if(lead_list == null || lead_list.size() == 0)
{
	info "FLEP-FT YES: lead not found - adding to unmatched sheet";
	safe_name = "";
	if(participant_name != null)
	{
		safe_name = participant_name.replaceAll("\"","'");
	}
	safe_email = "";
	if(participant_email != null)
	{
		safe_email = participant_email.replaceAll("\"","'");
	}
	timestamp_str = zoho.currenttime.toString("yyyy-MM-dd HH:mm:ss");
	json_data_str = '[{"Timestamp":"' + timestamp_str + '","Name":"' + safe_name + '","Email":"' + safe_email + '","Session":"Fresh LEP FT","Duration (mins)":"15+"}]';
	sheet_param = Map();
	sheet_param.put("method","worksheet.jsondata.append");
	sheet_param.put("worksheet_name","Sheet1");
	sheet_param.put("header_row","1");
	sheet_param.put("json_data",json_data_str);
	sheet_response = invokeurl
	[
		url :"https://sheet.zoho.in/api/v2/6n2nqc1869b674fcd4c47a645f30a6f38fb05"
		type :POST
		parameters:sheet_param
		connection:"zoho_sheet_mc"
	];
	info "FLEP-FT YES unmatched sheet: " + sheet_response.toString();
	return;
}
lead = lead_list.get(0);
lead_id = lead.get("id").toString();
// --- Gate: Confirmation must be Yes ---
conf = "";
if(lead.get("Fresh_LEP_FT_Confirmation") != null)
{
	conf = lead.get("Fresh_LEP_FT_Confirmation").toString().trim();
}
if(conf != "Yes")
{
	info "FLEP-FT YES: skip — Confirmation not Yes (conf=" + conf + ") lead=" + lead_id;
	return;
}
existing = "";
if(lead.get("Fresh_LEP_FT_Attendance") != null)
{
	existing = lead.get("Fresh_LEP_FT_Attendance").toString();
}
update_map = Map();
update_map.put("Fresh_LEP_FT_Attendance","Yes");
zoho.crm.updateRecord("Leads",lead_id,update_map);
info "FLEP-FT MARKED YES: lead=" + lead_id + " Fresh_LEP_FT_Attendance=Yes was=" + existing + " session=" + session_date;
}
