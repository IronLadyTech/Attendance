void mark_lep_attendance_final(string participant_email, string participant_name, string meeting_topic, string session_date, string session_day, string batch_date, string check_number, string present_emails, string attendance_result, string present_names)
{
	moduleName = "Session_Attendance";
	info "LEP: check=" + check_number + " email=" + participant_email + " result=" + attendance_result + " session=" + session_date;

	// ============================================================
	// VALIDATE MEETING
	// ============================================================
	if(meeting_topic == null || meeting_topic.trim() == "" || meeting_topic == "null")
	{
		info "LEP: no meeting topic - skipping";
		return;
	}

	topicL = meeting_topic.toLowerCase();
	isLepTopic = topicL.contains("il lep sessions") || topicL.contains("il lep") || topicL.contains("ironlady lep") || topicL.contains("lep day") || topicL.contains("2 day session") || topicL.contains("2-day session");
	if(!isLepTopic)
	{
		info "LEP: unknown topic - skipping: " + meeting_topic;
		return;
	}

	// ============================================================
	// DAY 1 / DAY 2
	// ============================================================
	fieldName = "LEP_Day_1_Session";
	isDay2 = false;

	if(session_day != null && session_day.toLowerCase().contains("day 2"))
	{
		fieldName = "LEP_Day_2_Session";
		isDay2 = true;
	}

	// ============================================================
	// COHORT / LEP START DATE
	// ============================================================
	lep_reg_date = batch_date;

	if(lep_reg_date == null || lep_reg_date.trim() == "" || lep_reg_date == "null")
	{
		lep_reg_date = session_date;

		if(lep_reg_date == null || lep_reg_date.trim() == "" || lep_reg_date == "null")
		{
			lep_reg_date = zoho.currenttime.toString("yyyy-MM-dd");
		}
		else
		{
			lep_reg_date = lep_reg_date.trim();
		}

		// If Day 2 and batch_date was not supplied,
		// cohort is previous day.
		if(isDay2)
		{
			day2_dt = lep_reg_date.toTime("yyyy-MM-dd");
			lep_reg_date = (day2_dt.toLong() - 86400000).toTime().toString("yyyy-MM-dd");
		}
	}
	else
	{
		lep_reg_date = lep_reg_date.trim();
	}

	if(lep_reg_date.length() < 10)
	{
		info "LEP: invalid cohort date=" + lep_reg_date;
		return;
	}

	lep_reg_ddMMyyyy = lep_reg_date.subString(8,10) + "-" + lep_reg_date.subString(5,7) + "-" + lep_reg_date.subString(0,4);

	info "LEP: cohort=" + lep_reg_date + " field=" + fieldName;

	// ============================================================
	// MODE (IMPORTANT)
	//
	// Individual FIRST if attendance_result is set (lep_check / lep_final).
	// Batch when attendance_result blank AND (present_emails OR present_names):
	//   checks 1–3 → not in room → Absent
	//   final (lep_final_batch) → never joined Zoom → Absent
	// ============================================================
	hasResult = attendance_result != null && attendance_result.trim() != "" && attendance_result != "null";
	hasPresentEmails = present_emails != null && present_emails.trim() != "" && present_emails != "null";
	hasPresentNames = present_names != null && present_names.trim() != "" && present_names != "null";
	batchMode = !hasResult && (hasPresentEmails || hasPresentNames);

	modeLabel = "individual";
	if(batchMode)
	{
		modeLabel = "batch";
	}
	info "LEP: mode=" + modeLabel + " name=" + participant_name + " result=" + attendance_result + " check=" + check_number;

	// ============================================================
	// BATCH MODE
	// Mark cohort members not in present_emails / present_names as Absent
	// ============================================================
	if(batchMode)
	{
		presentCsv = "";
		if(hasPresentEmails)
		{
			presentNormalized = present_emails.toLowerCase().trim();
			presentNormalized = presentNormalized.replaceAll(" ","");
			presentCsv = "," + presentNormalized + ",";
		}
		presentNameNorms = List();
		if(hasPresentNames)
		{
			nameParts = present_names.toList(",");
			for each np in nameParts
			{
				nn = np.toString().toLowerCase().trim();
				nn = nn.replaceAll("ms. ","").replaceAll("mr. ","").replaceAll("mrs. ","").replaceAll("dr. ","").replaceAll("prof. ","").replaceAll("miss ","").replaceAll("rev. ","");
				nn = nn.replaceAll("  "," ").trim();
				if(nn != "")
				{
					presentNameNorms.add(nn);
				}
			}
		}
		info "LEP batch: presentEmails=" + hasPresentEmails + " presentNames=" + presentNameNorms.size();

		allRecords = List();
		pageNums = {1,2,3,4,5};

		for each pageNum in pageNums
		{
			pageResp = zoho.crm.getRecords(moduleName,pageNum,200);
			pageCount = 0;

			if(pageResp != null)
			{
				pageList = pageResp.toString().toJsonList();

				for each pageRec in pageList
				{
					allRecords.add(pageRec);
					pageCount = pageCount + 1;
				}
			}

			if(pageCount < 200)
			{
				break;
			}
		}

		info "LEP batch: records loaded=" + allRecords.size();

		updateList = List();

		for each recJson in allRecords
		{
			reg = recJson.getJson("LEP_Start_Date");

			if(reg == null)
			{
				continue;
			}

			rawDate = reg.toString();
			dateMatches = false;

			if(rawDate.contains(lep_reg_date) || rawDate.contains(lep_reg_ddMMyyyy))
			{
				dateMatches = true;
			}
			else
			{
				try
				{
					dateYMD = reg.toString("yyyy-MM-dd");
					dateDMY = reg.toString("dd-MM-yyyy");

					if(dateYMD == lep_reg_date || dateDMY == lep_reg_ddMMyyyy)
					{
						dateMatches = true;
					}
				}
				catch(dateErr)
				{
					dateMatches = false;
				}
			}

			if(!dateMatches)
			{
				continue;
			}

			// Email or Lead_Email (optional — name-only CRM rows still get Absent)
			recEmail = recJson.getJson("Email");
			if(recEmail == null || recEmail.toString().trim() == "" || recEmail.toString() == "null")
			{
				recEmail = recJson.getJson("Lead_Email");
			}

			emailL = "";
			if(recEmail != null && recEmail.toString().trim() != "" && recEmail.toString() != "null")
			{
				emailL = recEmail.toString().toLowerCase().trim();
			}

			// Already accounted for (in room / ever joined) — skip Absent
			skipAbsent = false;
			if(emailL != "" && presentCsv != "" && presentCsv.contains("," + emailL + ","))
			{
				skipAbsent = true;
			}
			if(!skipAbsent && presentNameNorms.size() > 0)
			{
				cName = recJson.getJson("Name");
				if(cName != null)
				{
					cNameNorm = cName.toString().toLowerCase().trim();
					cNameNorm = cNameNorm.replaceAll("ms. ","").replaceAll("mr. ","").replaceAll("mrs. ","").replaceAll("dr. ","").replaceAll("prof. ","").replaceAll("miss ","").replaceAll("rev. ","");
					cNameNorm = cNameNorm.replaceAll("  "," ").trim();
					for each pnn in presentNameNorms
					{
						if(cNameNorm == pnn || cNameNorm.contains(pnn) || pnn.contains(cNameNorm))
						{
							skipAbsent = true;
							break;
						}
						pFirst = pnn;
						if(pnn.contains(" "))
						{
							pFirst = pnn.substring(0,pnn.indexOf(" "));
						}
						if(pFirst.length() >= 4)
						{
							if(cNameNorm == pFirst)
							{
								skipAbsent = true;
								break;
							}
							if(cNameNorm.length() > pFirst.length())
							{
								prefix = cNameNorm.substring(0,pFirst.length());
								nextCh = cNameNorm.substring(pFirst.length(),pFirst.length() + 1);
								if(prefix == pFirst && nextCh == " ")
								{
									skipAbsent = true;
									break;
								}
							}
						}
					}
				}
			}
			if(skipAbsent)
			{
				continue;
			}

			recordId = recJson.getJson("id");

			if(recordId == null)
			{
				continue;
			}

			recMap = Map();
			recMap.put("id",recordId.toString());
			recMap.put(fieldName,"Absent");

			updateList.add(recMap);
		}

		info "LEP batch: absent candidates=" + updateList.size();

		// ========================================================
		// BULK UPDATE
		// ========================================================
		updatedCount = 0;
		chunk = List();

		for each updateRec in updateList
		{
			chunk.add(updateRec);

			if(chunk.size() == 100)
			{
				bulkResp = zoho.crm.bulkUpdate(moduleName,chunk);

				info "LEP bulk response=" + bulkResp;

				if(bulkResp != null)
				{
					try
					{
						bulkList = bulkResp.toString().toJsonList();

						for each bulkRow in bulkList
						{
							rowStatus = bulkRow.getJson("status");

							if(rowStatus != null && rowStatus.toString() == "success")
							{
								updatedCount = updatedCount + 1;
							}
						}
					}
					catch(bulkErr)
					{
						info "LEP bulk parse error=" + bulkErr;
					}
				}

				chunk = List();
			}
		}

		if(chunk.size() > 0)
		{
			bulkResp = zoho.crm.bulkUpdate(moduleName,chunk);

			info "LEP final bulk response=" + bulkResp;

			if(bulkResp != null)
			{
				try
				{
					bulkList = bulkResp.toString().toJsonList();

					for each bulkRow in bulkList
					{
						rowStatus = bulkRow.getJson("status");

						if(rowStatus != null && rowStatus.toString() == "success")
						{
							updatedCount = updatedCount + 1;
						}
					}
				}
				catch(bulkErr2)
				{
					info "LEP final bulk parse error=" + bulkErr2;
				}
			}
		}

		info "LEP batch check=" + check_number + " cohort=" + lep_reg_date + " absent=" + updatedCount;
		return;
	}

	// ============================================================
	// INDIVIDUAL MODE
	// ============================================================
	if(attendance_result == null || attendance_result.trim() == "" || attendance_result == "null")
	{
		info "LEP: attendance_result missing - skipping";
		return;
	}

	resultVal = attendance_result.trim();

	if(resultVal != "Present" && resultVal != "Absent")
	{
		info "LEP: invalid attendance_result=" + resultVal;
		return;
	}

	foundRecord = null;
	matchedCohort = false;
	matchHow = "";

	hasEmail = participant_email != null && participant_email.trim() != "" && participant_email != "null";
	hasName = participant_name != null && participant_name.trim() != "" && participant_name != "null";

	if(!hasEmail && !hasName)
	{
		info "LEP: no email and no name in details - skipping";
		return;
	}

	zoomEmail = "";
	if(hasEmail)
	{
		zoomEmail = participant_email.trim().toLowerCase();
	}
	zoomNameRaw = "";
	zoomNameNorm = "";
	if(hasName)
	{
		zoomNameRaw = participant_name.trim();
		zoomNameNorm = zoomNameRaw.toLowerCase();
		zoomNameNorm = zoomNameNorm.replaceAll("ms. ","").replaceAll("mr. ","").replaceAll("mrs. ","").replaceAll("dr. ","").replaceAll("prof. ","").replaceAll("miss ","").replaceAll("rev. ","");
		zoomNameNorm = zoomNameNorm.replaceAll("  "," ").trim();
	}
	info "LEP: match email=" + zoomEmail + " nameNorm=" + zoomNameNorm;

	// Load Session_Attendance for this cohort, then match Email / Lead_Email / Name
	// (case-insensitive). searchRecords equals is too strict for Zoom display names.
	cohortRecs = List();
	pageNumsInd = {1,2,3,4,5};
	for each pageNumInd in pageNumsInd
	{
		pageRespInd = zoho.crm.getRecords(moduleName,pageNumInd,200);
		pageCountInd = 0;
		if(pageRespInd != null)
		{
			try
			{
				pageListInd = pageRespInd.toString().toJsonList();
				for each pageRecInd in pageListInd
				{
					pageCountInd = pageCountInd + 1;
					regInd = pageRecInd.getJson("LEP_Start_Date");
					if(regInd == null)
					{
						continue;
					}
					rawDateInd = regInd.toString();
					dateOk = false;
					if(rawDateInd.contains(lep_reg_date) || rawDateInd.contains(lep_reg_ddMMyyyy))
					{
						dateOk = true;
					}
					else
					{
						try
						{
							dateYMDInd = regInd.toString("yyyy-MM-dd");
							dateDMYInd = regInd.toString("dd-MM-yyyy");
							if(dateYMDInd == lep_reg_date || dateDMYInd == lep_reg_ddMMyyyy)
							{
								dateOk = true;
							}
						}
						catch(indDateErr)
						{
							dateOk = false;
						}
					}
					if(dateOk)
					{
						cohortRecs.add(pageRecInd);
					}
				}
			}
			catch(pageIndErr)
			{
				info "LEP individual page parse error=" + pageIndErr;
			}
		}
		if(pageCountInd < 200)
		{
			break;
		}
	}
	info "LEP: cohort records loaded=" + cohortRecs.size();

	// Pass 1 — exact email
	if(foundRecord == null && zoomEmail != "")
	{
		for each cand in cohortRecs
		{
			cEmail = cand.getJson("Email");
			cLead = cand.getJson("Lead_Email");
			cEmailL = "";
			cLeadL = "";
			if(cEmail != null)
			{
				cEmailL = cEmail.toString().toLowerCase().trim();
			}
			if(cLead != null)
			{
				cLeadL = cLead.toString().toLowerCase().trim();
			}
			if(cEmailL == zoomEmail || cLeadL == zoomEmail)
			{
				foundRecord = cand;
				matchedCohort = true;
				matchHow = "email";
				break;
			}
		}
	}

	// Pass 2 — exact normalized name
	if(foundRecord == null && zoomNameNorm != "")
	{
		for each cand in cohortRecs
		{
			cName = cand.getJson("Name");
			if(cName == null)
			{
				continue;
			}
			cNameNorm = cName.toString().toLowerCase().trim();
			cNameNorm = cNameNorm.replaceAll("ms. ","").replaceAll("mr. ","").replaceAll("mrs. ","").replaceAll("dr. ","").replaceAll("prof. ","").replaceAll("miss ","").replaceAll("rev. ","");
			cNameNorm = cNameNorm.replaceAll("  "," ").trim();
			if(cNameNorm == zoomNameNorm)
			{
				foundRecord = cand;
				matchedCohort = true;
				matchHow = "name-exact";
				break;
			}
		}
	}

	// Pass 3 — flexible name (contains) then UNIQUE first-name only
	if(foundRecord == null && zoomNameNorm != "" && zoomNameNorm.length() >= 4)
	{
		zoomFirst = zoomNameNorm;
		if(zoomNameNorm.contains(" "))
		{
			zoomFirst = zoomNameNorm.substring(0,zoomNameNorm.indexOf(" "));
		}
		// Pass 3a — CRM name contains full Zoom name (deterministic)
		for each cand in cohortRecs
		{
			cName = cand.getJson("Name");
			if(cName == null)
			{
				continue;
			}
			cNameNorm = cName.toString().toLowerCase().trim();
			cNameNorm = cNameNorm.replaceAll("ms. ","").replaceAll("mr. ","").replaceAll("mrs. ","").replaceAll("dr. ","").replaceAll("prof. ","").replaceAll("miss ","").replaceAll("rev. ","");
			cNameNorm = cNameNorm.replaceAll("  "," ").trim();
			if(cNameNorm.contains(zoomNameNorm))
			{
				foundRecord = cand;
				matchedCohort = true;
				matchHow = "name-contains";
				break;
			}
		}
	}

	// Pass 3b — first-name fallback ONLY if exactly one cohort candidate
	ambiguousMatch = false;
	if(foundRecord == null && zoomNameNorm != "" && zoomNameNorm.length() >= 4)
	{
		zoomFirst = zoomNameNorm;
		if(zoomNameNorm.contains(" "))
		{
			zoomFirst = zoomNameNorm.substring(0,zoomNameNorm.indexOf(" "));
		}
		firstMatches = List();
		if(zoomFirst.length() >= 4)
		{
			for each cand in cohortRecs
			{
				cName = cand.getJson("Name");
				if(cName == null)
				{
					continue;
				}
				cNameNorm = cName.toString().toLowerCase().trim();
				cNameNorm = cNameNorm.replaceAll("ms. ","").replaceAll("mr. ","").replaceAll("mrs. ","").replaceAll("dr. ","").replaceAll("prof. ","").replaceAll("miss ","").replaceAll("rev. ","");
				cNameNorm = cNameNorm.replaceAll("  "," ").trim();
				cFirst = cNameNorm;
				if(cNameNorm.contains(" "))
				{
					cFirst = cNameNorm.substring(0,cNameNorm.indexOf(" "));
				}
				if(cFirst == zoomFirst)
				{
					firstMatches.add(cand);
				}
			}
		}
		if(firstMatches.size() == 1)
		{
			foundRecord = firstMatches.get(0);
			matchedCohort = true;
			matchHow = "first-name-unique";
		}
		else if(firstMatches.size() > 1)
		{
			ambiguousMatch = true;
			matchHow = "first-name-ambiguous";
			info "LEP: ambiguous first name=" + zoomFirst + " candidates=" + firstMatches.size();
		}
	}

	// Ambiguous first-name: do NOT fall through to API search (wrong person risk)
	if(ambiguousMatch)
	{
		info "LEP: ambiguous participant - refusing automatic update name=" + zoomNameNorm;
		safe_name = "";
		if(participant_name != null)
		{
			safe_name = participant_name.replaceAll("\"","'");
		}
		safe_email = "";
		if(participant_email != null)
		{
			safe_email = participant_email.replaceAll("\"","'");
		}
		timestamp_str = zoho.currenttime.toString("yyyy-MM-dd HH:mm:ss");
		json_data_str = '[{"Timestamp":"' + timestamp_str + '","Name":"' + safe_name + '","Email":"' + safe_email + '","Session":"LEP AMBIGUOUS first-name","Duration (mins)":"0"}]';
		sheet_param = Map();
		sheet_param.put("method","worksheet.jsondata.append");
		sheet_param.put("worksheet_name","Sheet1");
		sheet_param.put("header_row","1");
		sheet_param.put("json_data",json_data_str);
		sheet_response = invokeurl
		[
			url :"https://sheet.zoho.in/api/v2/6n2nqc1869b674fcd4c47a645f30a6f38fb05"
			type :POST
			parameters:sheet_param
			connection:"zoho_sheet_mc"
		];
		info "LEP ambiguous sheet response=" + sheet_response.toString();
		return;
	}

	// Pass 4 — API search fallback (any module record) if cohort scan missed
	if(foundRecord == null && zoomEmail != "")
	{
		emailFields = List();
		emailFields.add("Email");
		emailFields.add("Lead_Email");
		for each emailField in emailFields
		{
			if(foundRecord != null)
			{
				break;
			}
			searchResp = zoho.crm.searchRecords(moduleName,"(" + emailField + ":equals:" + participant_email.trim() + ")",1,5);
			if(searchResp != null)
			{
				try
				{
					searchList = searchResp.toString().toJsonList();
					if(searchList.size() > 0)
					{
						foundRecord = searchList.get(0);
						matchHow = "email-search";
					}
				}
				catch(emailSearchErr)
				{
					info "LEP email search parse error=" + emailSearchErr;
				}
			}
		}
	}
	if(foundRecord == null && zoomNameRaw != "")
	{
		nameResp = zoho.crm.searchRecords(moduleName,"(Name:equals:" + zoomNameRaw + ")",1,5);
		if(nameResp != null)
		{
			try
			{
				nameList = nameResp.toString().toJsonList();
				if(nameList.size() > 0)
				{
					foundRecord = nameList.get(0);
					matchHow = "name-search";
				}
			}
			catch(nameSearchErr)
			{
				info "LEP name search parse error=" + nameSearchErr;
			}
		}
	}

	info "LEP: matchHow=" + matchHow;

	// ============================================================
	// STILL NOT FOUND → unmatched sheet
	// ============================================================
	if(foundRecord == null)
	{
		info "LEP: no Email/Name match - adding to unmatched sheet";

		safe_name = "";
		if(participant_name != null)
		{
			safe_name = participant_name.replaceAll("\"","'");
		}

		safe_email = "";
		if(participant_email != null)
		{
			safe_email = participant_email.replaceAll("\"","'");
		}

		safe_session_day = "";
		if(session_day != null)
		{
			safe_session_day = session_day.replaceAll("\"","'");
		}

		safe_check = "";
		if(check_number != null)
		{
			safe_check = check_number.replaceAll("\"","'");
		}

		safe_batch = "";
		if(lep_reg_date != null)
		{
			safe_batch = lep_reg_date.replaceAll("\"","'");
		}

		sheet_session = "LEP";

		if(safe_session_day != "")
		{
			sheet_session = sheet_session + " " + safe_session_day;
		}

		if(safe_check != "")
		{
			sheet_session = sheet_session + " - Check " + safe_check;
		}

		if(safe_batch != "")
		{
			sheet_session = sheet_session + " - Batch " + safe_batch;
		}

		timestamp_str = zoho.currenttime.toString("yyyy-MM-dd HH:mm:ss");

		json_data_str = '[{"Timestamp":"' + timestamp_str + '","Name":"' + safe_name + '","Email":"' + safe_email + '","Session":"' + sheet_session + '","Duration (mins)":"15+"}]';

		sheet_param = Map();
		sheet_param.put("method","worksheet.jsondata.append");
		sheet_param.put("worksheet_name","Sheet1");
		sheet_param.put("header_row","1");
		sheet_param.put("json_data",json_data_str);

		sheet_response = invokeurl
		[
			url :"https://sheet.zoho.in/api/v2/6n2nqc1869b674fcd4c47a645f30a6f38fb05"
			type :POST
			parameters:sheet_param
			connection:"zoho_sheet_mc"
		];

		info "LEP unmatched sheet response=" + sheet_response.toString();
		return;
	}

	// ============================================================
	// 4. MATCH FOUND -> UPDATE CRM
	// ============================================================
	rec_id_raw = foundRecord.getJson("id");

	if(rec_id_raw == null)
	{
		info "LEP: matched record has no CRM id";
		return;
	}

	rec_id = rec_id_raw.toString().toLong();

	updateMap = Map();
	updateMap.put(fieldName,resultVal);

	resp = zoho.crm.updateRecord(moduleName,rec_id,updateMap);

	info "LEP: updated check=" + check_number + " record=" + rec_id + " how=" + matchHow + " cohort=" + matchedCohort + " " + fieldName + "=" + resultVal;
	info "LEP CRM response=" + resp;
}