// Zoho Flow custom function — emails a participant-wise attendance report.
// Signature: void send_attendance_report(string start_time, string meeting_topic, string batch_date, string check_type, string ever_joined_emails, string present_emails)
// Connection: zoho_flow_to_zoho_crm
//
// Wire as a SECOND action on the same branches as mark_batch_attendance_checkpoint:
//   attendance.first_check → mark_batch_attendance_checkpoint (first) + send_attendance_report (first)
//   attendance.final_check → mark_batch_attendance_checkpoint (final) + send_attendance_report (final)
//
// Report contents:
//   FIRST check  → per-lead Yes/No + reason, counts, guests (joined but no CRM match)
//   FINAL check  → per-lead Yes/No/Absent + reason, counts, guests
//
// Status logic (email-based, same as attendance):
//   inPresent (present_emails)      → in Zoom room at this checkpoint
//   inEverJoined (ever_joined_emails) → joined at some point during the session
//   FIRST: present → Yes ; else No
//   FINAL: present → Yes ; else ever_joined → No ; else Absent

void send_attendance_report(string start_time, string meeting_topic, string batch_date, string check_type, string ever_joined_emails, string present_emails)
{
reportTo = "ironladytech@gmail.com,yaswanthgrandhi2580@gmail.com,brunda@iamironlady.com";
sessionDay = "";
if(meeting_topic != null && meeting_topic.trim() != "" && meeting_topic != "null")
{
	topicL = meeting_topic.toLowerCase();
	if(topicL.contains("bhag") || topicL.contains("breakthrough actions"))
	{
		sessionDay = "Day 1";
	}
	else if(topicL.contains("art of war") || topicL.contains("shameless pitching"))
	{
		sessionDay = "Day 2";
	}
}
if(sessionDay == "")
{
	info "report: unknown topic=" + meeting_topic;
	return;
}
if(check_type == null || check_type.trim() == "")
{
	info "report: check_type missing";
	return;
}
check_type = check_type.trim().toLowerCase();
if(check_type != "first" && check_type != "final" && check_type != "hour")
{
	info "report: invalid check_type=" + check_type;
	return;
}
attField = "Day_1_Attendance";
if(sessionDay == "Day 2")
{
	attField = "Day_2_Attendance";
}
batch_start_date = batch_date;
if(batch_start_date == null || batch_start_date.trim() == "" || batch_start_date == "null")
{
	if(start_time == null || start_time.trim() == "" || start_time == "null")
	{
		info "report: batch_date and start_time missing";
		return;
	}
	meetingDate = start_time.substring(0,10);
	meetingDt = meetingDate.toTime("yyyy-MM-dd");
	if(sessionDay == "Day 1")
	{
		batch_start_date = meetingDate;
	}
	else
	{
		batch_start_date = (meetingDt.toLong() - 86400000).toTime().toString("yyyy-MM-dd");
	}
}
batch_ddMMyyyy = batch_start_date.subString(8,10) + "-" + batch_start_date.subString(5,7) + "-" + batch_start_date.subString(0,4);
// Normalise join lists to ",a,b," form for safe membership checks + a set of joined emails for guests.
presentCsv = "";
if(present_emails != null && present_emails.trim() != "" && present_emails != "null")
{
	presentCsv = "," + present_emails.toLowerCase().trim() + ",";
}
everCsv = "";
if(ever_joined_emails != null && ever_joined_emails.trim() != "" && ever_joined_emails != "null")
{
	everCsv = "," + ever_joined_emails.toLowerCase().trim() + ",";
}
// CRM view filters by calendar date (10/07/26); strict IST datetime between can miss edge cases.
batchDt = batch_start_date.toTime("yyyy-MM-dd");
dayBefore = (batchDt.toLong() - 86400000).toTime().toString("yyyy-MM-dd");
dayAfter = (batchDt.toLong() + 86400000).toTime().toString("yyyy-MM-dd");
batch_ddMMyy = batch_start_date.subString(8,10) + "/" + batch_start_date.subString(5,7) + "/" + batch_start_date.subString(2,4);
dayStart = dayBefore + "T00:00:00+05:30";
dayEnd = dayAfter + "T23:59:59+05:30";
allLeads = List();
seenIds = ",";
offsets = {0,200,400,600,800,1000,1200,1400,1600,1800};
for each off in offsets
{
	coqlQuery = "select id, Email, Full_Name, Day_1_Attendance, Day_2_Attendance, MC_Start_Date_Time from Leads where Payment_Status = 'Completed' and (MC_Start_Date_Time between '" + dayStart + "' and '" + dayEnd + "') limit " + off + ", 200";
	coqlBody = Map();
	coqlBody.put("select_query",coqlQuery);
	coqlResp = invokeurl
	[
		url :"https://www.zohoapis.in/crm/v7/coql"
		type :POST
		parameters:coqlBody.toString()
		connection:"zoho_flow_to_zoho_crm"
	];
	pageLeads = coqlResp.get("data");
	if(pageLeads == null || pageLeads.size() == 0)
	{
		if(off == 0)
		{
			info "COQL resp (offset 0)=" + coqlResp.toString();
		}
		break;
	}
	pageAdded = 0;
	for each lead in pageLeads
	{
		leadId = lead.get("id").toString();
		if(seenIds.contains("," + leadId + ","))
		{
			continue;
		}
		leadDate = lead.get("MC_Start_Date_Time");
		dateMatch = false;
		if(leadDate != null)
		{
			dateYMD = leadDate.toString("yyyy-MM-dd");
			dateDMY = leadDate.toString("dd-MM-yyyy");
			rawDate = leadDate.toString();
			if(dateYMD == batch_start_date || dateDMY == batch_ddMMyyyy || rawDate.contains(batch_start_date) || rawDate.contains(batch_ddMMyyyy) || rawDate.contains(batch_ddMMyy))
			{
				dateMatch = true;
			}
		}
		if(dateMatch)
		{
			seenIds = seenIds + leadId + ",";
			allLeads.add(lead);
			pageAdded = pageAdded + 1;
		}
	}
	info "report COQL page offset=" + off + " raw=" + pageLeads.size() + " matched=" + pageAdded;
	if(pageLeads.size() < 200)
	{
		break;
	}
}
info "report: batch leads fetched (COQL): " + allLeads.size();
yesCount = 0;
noCount = 0;
absentCount = 0;
matchedCount = 0;
rows = "";
crmEmails = "";
for each lead in allLeads
{
	matchedCount = matchedCount + 1;
	leadEmail = lead.get("Email");
	leadName = lead.get("Full_Name");
	if(leadName == null || leadName == "null")
	{
		leadName = "";
	}
	emailL = "";
	if(leadEmail != null && leadEmail.trim() != "" && leadEmail != "null")
	{
		emailL = leadEmail.toLowerCase().trim();
		crmEmails = crmEmails + "," + emailL;
	}
	inPresent = false;
	inEverJoined = false;
	if(emailL != "" && presentCsv != "" && presentCsv.contains("," + emailL + ","))
	{
		inPresent = true;
	}
	if(emailL != "" && everCsv != "" && everCsv.contains("," + emailL + ","))
	{
		inEverJoined = true;
	}
	status = "";
	reason = "";
	if(check_type == "first")
	{
		if(inPresent)
		{
			status = "Yes";
			reason = "In Zoom room at 15-min check";
		}
		else
		{
			status = "No";
			reason = "Not in room at 15 min (never joined or left early)";
		}
	}
	else if(check_type == "hour")
	{
		if(inPresent)
		{
			status = "Yes";
			reason = "In Zoom room at 1-hour check (late opportunity — upgraded to Yes)";
		}
		else
		{
			status = "(unchanged)";
			reason = "Not in room at 1-hour check — existing CRM status kept";
		}
	}
	else
	{
		if(inPresent)
		{
			status = "Yes";
			reason = "In Zoom room at 30-min check";
		}
		else if(inEverJoined)
		{
			status = "No";
			reason = "Joined but left before 30 min (dropout)";
		}
		else
		{
			status = "Absent";
			reason = "Never joined Zoom during the session";
		}
	}
	if(status == "Yes")
	{
		yesCount = yesCount + 1;
	}
	else if(status == "No")
	{
		noCount = noCount + 1;
	}
	else if(status == "Absent")
	{
		absentCount = absentCount + 1;
	}
	rowColor = "#ffffff";
	if(status == "Yes")
	{
		rowColor = "#e8f5e9";
	}
	else if(status == "No")
	{
		rowColor = "#fff8e1";
	}
	else
	{
		rowColor = "#ffebee";
	}
	rows = rows + "<tr style='background:" + rowColor + ";'><td>" + matchedCount + "</td><td>" + leadEmail + "</td><td>" + leadName + "</td><td><b>" + status + "</b></td><td>" + reason + "</td></tr>";
}
// Guests: emails that joined Zoom but do not match any CRM lead in this batch.
crmEmailsCsv = crmEmails + ",";
guestRows = "";
guestCount = 0;
guestSeen = ",";
if(everCsv != "")
{
	joinedList = ever_joined_emails.toLowerCase().trim().toList(",");
	for each ge in joinedList
	{
		g = ge.trim();
		if(g != "" && !crmEmailsCsv.contains("," + g + ",") && !guestSeen.contains("," + g + ","))
		{
			guestSeen = guestSeen + g + ",";
			guestCount = guestCount + 1;
			gStatus = "No";
			gReason = "Joined but left before this check";
			if(presentCsv.contains("," + g + ","))
			{
				gStatus = "Yes";
				gReason = "In Zoom room at this check";
			}
			guestRows = guestRows + "<tr style='background:#ede7f6;'><td>" + guestCount + "</td><td>" + g + "</td><td><b>" + gStatus + "</b> (guest)</td><td>" + gReason + " — no CRM match, needs manual review</td></tr>";
		}
	}
}
checkLabel = "First Check (15 minutes)";
if(check_type == "final")
{
	checkLabel = "Final Check (30 minutes)";
}
if(check_type == "hour")
{
	checkLabel = "Hour Check (60 minutes — late opportunity)";
}
countLine = "Yes: <b>" + yesCount + "</b> &nbsp;|&nbsp; No: <b>" + noCount + "</b>";
if(check_type == "final")
{
	countLine = countLine + " &nbsp;|&nbsp; Absent: <b>" + absentCount + "</b>";
}
countLine = countLine + " &nbsp;|&nbsp; Total matched: <b>" + matchedCount + "</b>";
html = "<div style='font-family:Segoe UI,Arial,sans-serif;color:#222;'>";
html = html + "<h2>MC Attendance Report — " + checkLabel + "</h2>";
html = html + "<p><b>" + sessionDay + "</b> &nbsp;|&nbsp; Batch: <b>" + batch_start_date + "</b> &nbsp;|&nbsp; Session: " + meeting_topic + "</p>";
html = html + "<p style='font-size:15px;'>" + countLine + "</p>";
html = html + "<table border='1' cellspacing='0' cellpadding='6' style='border-collapse:collapse;font-size:13px;'>";
html = html + "<tr style='background:#f0f0f0;'><th>#</th><th>Email</th><th>Name</th><th>Status</th><th>Reason</th></tr>";
html = html + rows;
html = html + "</table>";
if(guestCount > 0)
{
	html = html + "<h3>Guests / Unmatched (joined Zoom, no CRM match)</h3>";
	html = html + "<table border='1' cellspacing='0' cellpadding='6' style='border-collapse:collapse;font-size:13px;'>";
	html = html + "<tr style='background:#f0f0f0;'><th>#</th><th>Email</th><th>Status</th><th>Note</th></tr>";
	html = html + guestRows;
	html = html + "</table>";
}
html = html + "<h3>What the statuses mean</h3><ul>";
if(check_type == "first")
{
	html = html + "<li><b>Yes</b> — present in the room at the 15-minute mark.</li>";
	html = html + "<li><b>No</b> — not in the room at 15 min (never joined, running late, or left early). Sales can call the No list.</li>";
}
else if(check_type == "hour")
{
	html = html + "<li><b>Yes</b> — in the room at the 1-hour mark; No or Absent is upgraded to Yes.</li>";
	html = html + "<li><b>(unchanged)</b> — not in the room at 1 hour; existing CRM status is kept.</li>";
}
else
{
	html = html + "<li><b>Yes</b> — in the room at the 30-minute mark (includes late joiners upgraded from No).</li>";
	html = html + "<li><b>No</b> — joined at some point but left before 30 min (dropout).</li>";
	html = html + "<li><b>Absent</b> — never joined Zoom during the session.</li>";
}
html = html + "</ul><p style='color:#888;font-size:12px;'>Statuses are matched by email. Guests are people who joined Zoom with an email not found in CRM for this batch.</p></div>";
subject = "MC Attendance — " + checkLabel + " — " + sessionDay + " " + batch_start_date + " (Yes " + yesCount + " / No " + noCount;
if(check_type == "final")
{
	subject = subject + " / Absent " + absentCount;
}
subject = subject + ")";
sendmail
[
	from :zoho.loginuserid
	to :reportTo
	subject :subject
	message :html
]
info "report sent: type=" + check_type + " matched=" + matchedCount + " yes=" + yesCount + " no=" + noCount + " absent=" + absentCount + " guests=" + guestCount;
}
