// Zoho Flow custom function — replaces set_blank_automation_not_attended for MC checkpoint model
// Signature: void mark_batch_attendance_checkpoint(string start_time, string meeting_topic, string batch_date, string check_type, string ever_joined_emails, string present_emails)
//   check_type = "first"  → T+15: blank → No (sales calls)
//   check_type = "final"  → T+30 safety: blank + in room → Yes; blank + never joined → Absent; dropout → No
//   check_type = "hour"   → T+60 late opportunity: in room + No/Absent → Yes; not in room → unchanged
// Connection: zoho_flow_to_zoho_crm
//
// Flow mapping (attendance.first_check branch):
//   start_time    = ${webhookTrigger.payload.start_time}
//   meeting_topic = ${webhookTrigger.payload.meeting_topic}
//   batch_date    = ${webhookTrigger.payload.batch_date}
//   check_type    = first
//
// Flow mapping (attendance.final_check branch):
//   check_type    = final
//   ever_joined_emails = ${webhookTrigger.payload.ever_joined_emails}
//   present_emails     = ${webhookTrigger.payload.present_emails}

void mark_batch_attendance_checkpoint(string start_time, string meeting_topic, string batch_date, string check_type, string ever_joined_emails, string present_emails)
{
sessionDay = "";
if(meeting_topic != null && meeting_topic.trim() != "" && meeting_topic != "null")
{
	topicL = meeting_topic.toLowerCase();
	if(topicL.contains("bhag") || topicL.contains("breakthrough actions"))
	{
		sessionDay = "Day 1";
	}
	else if(topicL.contains("art of war") || topicL.contains("shameless pitching"))
	{
		sessionDay = "Day 2";
	}
}
if(sessionDay == "")
{
	info "checkpoint: unknown topic=" + meeting_topic;
	return;
}
if(check_type == null || check_type.trim() == "")
{
	info "checkpoint: check_type missing";
	return;
}
check_type = check_type.trim().toLowerCase();
if(check_type != "first" && check_type != "final" && check_type != "hour")
{
	info "checkpoint: invalid check_type=" + check_type;
	return;
}
batch_start_date = batch_date;
if(batch_start_date == null || batch_start_date.trim() == "" || batch_start_date == "null")
{
	if(start_time == null || start_time.trim() == "" || start_time == "null")
	{
		info "checkpoint: batch_date and start_time missing";
		return;
	}
	meetingDate = start_time.substring(0,10);
	meetingDt = meetingDate.toTime("yyyy-MM-dd");
	if(sessionDay == "Day 1")
	{
		batch_start_date = meetingDate;
	}
	else
	{
		batch_start_date = (meetingDt.toLong() - 86400000).toTime().toString("yyyy-MM-dd");
	}
}
batch_ddMMyyyy = batch_start_date.subString(8,10) + "-" + batch_start_date.subString(5,7) + "-" + batch_start_date.subString(0,4);
info "checkpoint: type=" + check_type + " session=" + sessionDay + " batch=" + batch_start_date;
// Batch-scoped COQL: Completed + MC_Start_Date_Time on batch day (matches CRM view count).
dayStart = batch_start_date + "T00:00:00+05:30";
dayEnd = batch_start_date + "T23:59:59+05:30";
allLeads = List();
offsets = {0,200,400,600,800,1000,1200,1400,1600,1800};
for each off in offsets
{
	coqlQuery = "select id, Email, Full_Name, Day_1_Attendance, Day_2_Attendance, MC_Start_Date_Time from Leads where Payment_Status = 'Completed' and MC_Start_Date_Time >= '" + dayStart + "' and MC_Start_Date_Time <= '" + dayEnd + "' limit 200 offset " + off;
	coqlBody = Map();
	coqlBody.put("select_query",coqlQuery);
	coqlResp = invokeurl
	[
		url :"https://www.zohoapis.in/crm/v7/coql"
		type :POST
		parameters:coqlBody.toString()
		connection:"zoho_flow_to_zoho_crm"
	];
	pageLeads = coqlResp.get("data");
	if(pageLeads == null || pageLeads.size() == 0)
	{
		break;
	}
	allLeads.addAll(pageLeads);
	info "COQL batch page offset=" + off + " size=" + pageLeads.size();
	if(pageLeads.size() < 200)
	{
		break;
	}
}
info "Total batch leads fetched (COQL): " + allLeads.size();
updateList = List();
skippedCount = 0;
matchedCount = 0;
for each lead in allLeads
{
	matchedCount = matchedCount + 1;
	leadId = lead.get("id");
	day1 = lead.get("Day_1_Attendance");
	day2 = lead.get("Day_2_Attendance");
	recMap = Map();
	recMap.put("id",leadId);
	needsUpdate = false;
	day1Blank = day1 == null || day1 == "-None-" || day1.toString().trim() == "" || day1.toString().trim() == "null";
	day2Blank = day2 == null || day2 == "-None-" || day2.toString().trim() == "" || day2.toString().trim() == "null";
			if(check_type == "first")
			{
				if(sessionDay == "Day 1")
				{
					if(day1Blank)
					{
						recMap.put("Day_1_Attendance","No");
						needsUpdate = true;
					}
				}
				else
				{
					if(day1Blank)
					{
						recMap.put("Day_1_Attendance","No");
						needsUpdate = true;
					}
					if(day2Blank)
					{
						recMap.put("Day_2_Attendance","No");
						needsUpdate = true;
					}
				}
			}
			else if(check_type == "hour")
			{
				// T+60 — upgrade only: in room at 1hr + No/Absent → Yes; already Yes or not present → skip
				inPresent = false;
				leadEmail = lead.get("Email");
				if(leadEmail != null && leadEmail.trim() != "" && leadEmail != "null")
				{
					emailL = leadEmail.toLowerCase().trim();
					if(present_emails != null && present_emails.trim() != "" && present_emails != "null")
					{
						peCsv = "," + present_emails.toLowerCase() + ",";
						if(peCsv.contains("," + emailL + ","))
						{
							inPresent = true;
						}
					}
				}
				if(sessionDay == "Day 1")
				{
					if(inPresent)
					{
						cur1 = "";
						if(day1 != null)
						{
							cur1 = day1.toString().trim();
						}
						if(cur1 == "Yes")
						{
							// unchanged
						}
						else if(cur1 == "No" || cur1 == "Absent" || day1Blank)
						{
							recMap.put("Day_1_Attendance","Yes");
							needsUpdate = true;
						}
					}
				}
				else
				{
					if(inPresent)
					{
						cur2 = "";
						if(day2 != null)
						{
							cur2 = day2.toString().trim();
						}
						if(cur2 == "Yes")
						{
							// unchanged
						}
						else if(cur2 == "No" || cur2 == "Absent" || day2Blank)
						{
							recMap.put("Day_2_Attendance","Yes");
							needsUpdate = true;
						}
					}
				}
			}
			else
			{
				// T+30 safety net — no blanks left on batch:
				//   in room at T+30 (present_emails) → Yes
				//   joined but left (ever_joined, not present) → No
				//   never joined → Absent
				inEverJoined = false;
				inPresent = false;
				leadEmail = lead.get("Email");
				if(leadEmail != null && leadEmail.trim() != "" && leadEmail != "null")
				{
					emailL = leadEmail.toLowerCase().trim();
					if(present_emails != null && present_emails.trim() != "" && present_emails != "null")
					{
						peCsv = "," + present_emails.toLowerCase() + ",";
						if(peCsv.contains("," + emailL + ","))
						{
							inPresent = true;
						}
					}
					if(ever_joined_emails != null && ever_joined_emails.trim() != "" && ever_joined_emails != "null")
					{
						ejCsv = "," + ever_joined_emails.toLowerCase() + ",";
						if(ejCsv.contains("," + emailL + ","))
						{
							inEverJoined = true;
						}
					}
				}
				if(sessionDay == "Day 1")
				{
					if(day1Blank)
					{
						if(inPresent)
						{
							recMap.put("Day_1_Attendance","Yes");
						}
						else if(inEverJoined)
						{
							recMap.put("Day_1_Attendance","No");
						}
						else
						{
							recMap.put("Day_1_Attendance","Absent");
						}
						needsUpdate = true;
					}
					else if(day1.toString() == "Yes")
					{
						// already attended — skip
					}
					else if(day1.toString() == "No")
					{
						if(inPresent)
						{
							recMap.put("Day_1_Attendance","Yes");
							needsUpdate = true;
						}
						else if(!inEverJoined)
						{
							recMap.put("Day_1_Attendance","Absent");
							needsUpdate = true;
						}
					}
				}
				else
				{
					if(day1Blank)
					{
						if(inPresent)
						{
							recMap.put("Day_1_Attendance","Yes");
						}
						else if(inEverJoined)
						{
							recMap.put("Day_1_Attendance","No");
						}
						else
						{
							recMap.put("Day_1_Attendance","Absent");
						}
						needsUpdate = true;
					}
					else if(day1 != null && day1.toString() == "No")
					{
						if(inPresent)
						{
							recMap.put("Day_1_Attendance","Yes");
							needsUpdate = true;
						}
						else if(!inEverJoined)
						{
							recMap.put("Day_1_Attendance","Absent");
							needsUpdate = true;
						}
					}
					if(day2Blank)
					{
						if(inPresent)
						{
							recMap.put("Day_2_Attendance","Yes");
						}
						else if(inEverJoined)
						{
							recMap.put("Day_2_Attendance","No");
						}
						else
						{
							recMap.put("Day_2_Attendance","Absent");
						}
						needsUpdate = true;
					}
					else if(day2.toString() == "Yes")
					{
						// skip
					}
					else if(day2.toString() == "No")
					{
						if(inPresent)
						{
							recMap.put("Day_2_Attendance","Yes");
							needsUpdate = true;
						}
						else if(!inEverJoined)
						{
							recMap.put("Day_2_Attendance","Absent");
							needsUpdate = true;
						}
					}
				}
			}
			if(needsUpdate)
			{
				updateList.add(recMap);
			}
			else
			{
				skippedCount = skippedCount + 1;
			}
}
// bulkUpdate allows max 100 records per call — send in groups of 100 (handles any batch size, 350+)
updatedCount = 0;
chunkNum = 0;
chunk = List();
for each recMap in updateList
{
	chunk.add(recMap);
	if(chunk.size() == 100)
	{
		chunkNum = chunkNum + 1;
		bulkResp = zoho.crm.bulkUpdate("Leads",chunk);
		updatedCount = updatedCount + chunk.size();
		info "bulkUpdate chunk" + chunkNum + " sent=" + chunk.size() + " resp=" + bulkResp.toString();
		chunk = List();
	}
}
if(chunk.size() > 0)
{
	chunkNum = chunkNum + 1;
	bulkResp = zoho.crm.bulkUpdate("Leads",chunk);
	updatedCount = updatedCount + chunk.size();
	info "bulkUpdate chunk" + chunkNum + " sent=" + chunk.size() + " resp=" + bulkResp.toString();
}
info "checkpoint: type=" + check_type + " matched=" + matchedCount + " updated=" + updatedCount + " skipped=" + skippedCount + " chunks=" + chunkNum;
}
